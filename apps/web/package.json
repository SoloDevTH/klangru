{
  "name": "@klangru/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync-content": "node scripts/sync-content.mjs",
    "predev": "npm run sync-content",
    "dev": "next dev",
    "prebuild": "npm run sync-content",
    "build": "next build && node scripts/offline-manifest.mjs",
    "test": "tsx --test lib/logic.test.ts",
    "typecheck": "tsc --noEmit",
    "icons": "python3 scripts/make-icons.py",
    "e2e": "node e2e/smoke.mjs",
    "android:sync": "cap sync android && rm -rf android/app/src/main/assets/public/admin",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "cms": "npx -y decap-server@3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource/bai-jamjuree": "^5.3.0",
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "3dmol": "^2.5.5",
    "hanzi-writer": "^3.7.3",
    "jsxgraph": "^1.14.1",
    "katex": "^0.16.47",
    "mathlive": "^0.111.1",
    "minisearch": "^7.2.0",
    "next": "^16.0.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "ts-fsrs": "^5.4.2"
  }
}
